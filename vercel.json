{
  "headers": [
    {
      "source": "/bank.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp3|m4a|ogg|wav|png|jpg|jpeg|webp|gif|svg|woff2|woff|ttf|otf|wasm|task)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
